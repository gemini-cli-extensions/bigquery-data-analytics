{
  "name": "bigquery-data-analytics",
  "version": "0.2.4",
  "description": "Connect, query, and generate data insights for BigQuery datasets and data.",
  "author": {
    "name": "Google LLC",
    "email": "data-cloud-ai-integrations@google.com"
  },
  "homepage": "https://cloud.google.com/bigquery",
  "repository": "https://github.com/gemini-cli-extensions/bigquery-data-analytics",
  "license": "Apache-2.0",
  "skills": "./skills/",
  "userConfig": {
    "bigquery_project": {
      "title": "Project ID",
      "description": "ID of the Google Cloud project",
      "type": "string",
      "sensitive": false
    },
    "bigquery_location": {
      "title": "Location",
      "description": "(Optional) Location of the BigQuery resources",
      "type": "string",
      "sensitive": false
    }
  },
  "mcpServers": {
    "bigquery": {
      "command": "npx",
      "args": [
        "-y",
        "@toolbox-sdk/server@1.10.0",
        "--prebuilt",
        "bigquery",
        "--stdio"
      ],
      "env": {
        "BIGQUERY_PROJECT": "${user_config.bigquery_project}",
        "BIGQUERY_LOCATION": "${user_config.bigquery_location}"
      }
    }
  }
}
